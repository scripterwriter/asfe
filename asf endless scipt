            Chikara = ChikaraTab,
            Teleports = TeleportsTab,
            ESP = EspTab,
            Codes = CodesTab,
            Misc = MiscTab,
            Extras = ExtrasTab,
            Settings = SettingsTab
        }, Rayfield)
    end)
end)

