local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "AFSE | #1 Script",
    LoadingTitle = "AFSE",
    LoadingSubtitle = "by VisualDoggyStudios",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "AFSE",
        FileName = "Config"
    },
    Discord = {
        Enabled = true,
        Invite = "bZv3Ceagqu",
        RememberJoins = true
    },
    KeySystem = false
})

local AutofarmTab = Window:CreateTab("Autofarm", "dumbbell")
local FruitsTab = Window:CreateTab("Fruits", "apple")
