local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "AFSE | #1 Script " .. Fluent.LibraryVersion,
    SubTitle = "by VisualDoggyStudios",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Theme = "Dark",
    Acrylic = false,
    MinimizeKey = Enum.KeyCode.MinimizeKey
})

-- Create all tabs
local AutofarmTab = Window:AddTab({ Title = "Autofarm", Icon = "bot" })
local FruitsTab    = Window:AddTab({ Title = "Fruits", Icon = "apple" })
local MobsTab      = Window:AddTab({ Title = "Mobs", Icon = "swords" })
local ChikaraTab   = Window:AddTab({ Title = "Chikara", Icon = "gift" })
local TeleportsTab = Window:AddTab({ Title = "Teleports", Icon = "map-pin" })
local EspTab       = Window:AddTab({ Title = "ESP", Icon = "eye" })
local CodesTab     = Window:AddTab({ Title = "Codes", Icon = "ticket" })
local MiscTab      = Window:AddTab({ Title = "Misc", Icon = "box" })
local SettingsTab  = Window:AddTab({ Title = "Settings", Icon = "settings" })
local ExtrasTab    = Window:AddTab({ Title = "Extras", Icon = "crown" })

-- Discord invite copy + notification
setclipboard("https://discord.gg/bZv3Ceagqu")
Fluent:Notify({
    Title = "AFSE Loaded!",
    Content = "All features ready.\nDiscord invite copied.\nGo dominate the game!",
    Duration = 8
})

-- Helper to fire training remote (assuming the remote path is correct)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RemoteEvent = ReplicatedStorage:WaitForChild("RemoteSignals"):WaitForChild("EventSignal")

local function fireTrain(statId)
    RemoteEvent:FireServer("Train", statId)
end

-- Autofarm Tab
AutofarmTab:AddParagraph({
    Title = "Autofarm Features",
    Content = "Toggle the features below to enable or disable automatic actions."
})

-- Auto Train Strength (stat 1)
AutofarmTab:AddToggle("AutoTrain", {
    Title = "Auto Train Strength",
    Default = false,
    Callback = function(state)
        spawn(function()
            while state do
                fireTrain(1)
                task.wait(0.1)
            end
        end)
    end
})

