Rayfield:Notify({
    Title = "AFSE Loaded!",
    Content = "All features ready.\nDiscord invite copied.\nGo dominate the game!",
    Duration = 8,
    Image = "check"
})

setclipboard("https://discord.gg/bZv3Ceagqu")

-- Autofarm Info Paragraph
AutofarmTab:CreateParagraph({
    Title = "Autofarm Features",
    Content = "Toggle the features below to enable or disable automatic actions."
})

-- Find the correct remote (common in AFS-style games)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RemoteEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Train") -- Most likely path based on similar games

-- Auto Train Strength (1)
AutofarmTab:CreateToggle({
    Name = "Auto Train Strength",
    CurrentValue = false,
    Callback = function(Value)
        while Value do
            RemoteEvent:FireServer(1)
            task.wait(0.1)
        end
    end
})

