-- Note: The external module loads (fruits, mobs, etc.) remain as separate HttpGet/loadstring calls, as they initialize with the tabs passed in a table.
-- They should work similarly with Rayfield tabs, assuming the modules support it or can be adapted minimally.

-- Example for one external load (repeat for others):
task.spawn(function()
    local success, err = pcall(function()
        local scriptData = game:HttpGet("https://raw.githubusercontent.com/VisualDoggyStudios/Anime-Fighting-Simulator-Endless/refs/heads/main/obfuscated_autofarm.lua")
        loadstring(scriptData)({
            Autofarm = AutofarmTab,
            Fruits = FruitsTab,
            Mobs = MobsTab,
            Chikara = ChikaraTab,
            Teleports = TeleportsTab,
            ESP = EspTab,
            Codes = CodesTab,
            Misc = MiscTab,
            Extras = ExtrasTab,
            Settings = SettingsTab
        })
    end)
end)

